# --- App ---
APP_ENV=dev                          # dev | prod
LOG_LEVEL=INFO
SERVICE_API_KEY=change-me            # required for POST /sync/run and other admin endpoints

# --- Database ---
# SQLite (dev default):
DATABASE_URL=sqlite+pysqlite:///./autobuy.db
# Postgres (prod):
# DATABASE_URL=postgresql+psycopg://autobuy:autobuy@db:5432/autobuy

# --- JD VOP ---
JD_MODE=mock                         # mock | live
JD_BASE_URL=https://bizapi.jd.com
JD_APP_KEY=
JD_APP_SECRET=
JD_USERNAME=
JD_PASSWORD=
JD_CALLBACK_URL=                     # public HTTPS URL to register in VOP cabinet, e.g. https://autobuy.example.com/jd/callback

# --- Currency ---
# JD prices come in CNY. Convert to RUB by static rate (edit manually as needed).
CNY_RUB_RATE=12.50

# --- Defaults for missing JD fields ---
DEFAULT_WEIGHT_G=500
DEFAULT_LENGTH_CM=20
DEFAULT_WIDTH_CM=15
DEFAULT_HEIGHT_CM=10

# --- Sync scheduler ---
SYNC_INTERVAL_MINUTES=                # empty = scheduler disabled, manual /sync/run only
SYNC_LOOKBACK_MINUTES=60              # how far back to query JD on each scheduled tick
