# --- App ---
# APP_ENV: dev | prod
APP_ENV=dev
LOG_LEVEL=INFO
# Required for POST /sync/run and other admin endpoints. Generate via:
#   openssl rand -hex 32
SERVICE_API_KEY=change-me

# --- Database ---
# SQLite (dev default):
DATABASE_URL=sqlite+pysqlite:///./autobuy.db
# Postgres (prod, used automatically when running via docker-compose):
# DATABASE_URL=postgresql+psycopg://autobuy:autobuy@db:5432/autobuy

# --- JD VOP ---
# JD_MODE: mock | live
JD_MODE=mock
JD_BASE_URL=https://bizapi.jd.com
JD_APP_KEY=
JD_APP_SECRET=
JD_USERNAME=
JD_PASSWORD=
# Public HTTPS URL to register in the JD VOP cabinet,
# e.g. https://autobuy.example.com/jd/callback
JD_CALLBACK_URL=

# --- Currency ---
# JD prices come in CNY. Convert to RUB by static rate (edit manually as needed).
CNY_RUB_RATE=12.50

# --- Defaults for missing JD fields ---
DEFAULT_WEIGHT_G=500
DEFAULT_LENGTH_CM=20
DEFAULT_WIDTH_CM=15
DEFAULT_HEIGHT_CM=10

# --- Sync scheduler (JD orders) ---
# Empty = scheduler disabled, manual /sync/run only.
# Set to a number (e.g. 15) to enable periodic sync every N minutes.
SYNC_INTERVAL_MINUTES=
# How far back to query JD on each scheduled tick.
SYNC_LOOKBACK_MINUTES=60

# --- Telegram notifications ---
# Create a bot via @BotFather, get the token.
# Get chat_id: send any message to the bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the "id" from the "chat" object.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to false to receive only error notifications (recommended for production).
TELEGRAM_NOTIFY_SUCCESS=true

# --- Tmall / Taobao Open Platform (taoworld.com) ---
# TMALL_MODE: mock | live
TMALL_MODE=mock
TMALL_APP_KEY=
TMALL_APP_SECRET=
# Items fetched per taobao.items.list.get call (max 40).
TMALL_BATCH_SIZE=40
# Empty = manual /feed/sync only. Set to N minutes for scheduled refresh.
TMALL_SYNC_INTERVAL_MINUTES=
